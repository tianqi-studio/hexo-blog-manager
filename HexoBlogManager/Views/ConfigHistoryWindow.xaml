<Window x:Class="HexoBlogManager.Views.ConfigHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置历史备份"
        Width="600" Height="500"
        MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="HistoryCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HistoryList" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Soft}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="Auto"/>   <!-- 文件选择 -->
            <RowDefinition Height="Auto"/>   <!-- 说明 -->
            <RowDefinition Height="*"/>      <!-- 列表 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="配置历史备份" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock x:Name="TxtSubtitle" FontSize="11.5" Margin="0,4,0,0"
                       Foreground="{StaticResource Brush.TextTertiary}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="配置文件" VerticalAlignment="Center"
                       Style="{StaticResource Text.Label}" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbTarget" Grid.Column="1"
                      Style="{StaticResource HistoryCombo}"
                      DisplayMemberPath="Label"
                      SelectionChanged="CmbTarget_SelectionChanged"/>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,10" FontSize="11.5"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="每次保存前都会把原文件另存为 .bak。选中一条记录后点「还原」，当前文件会先被备份，还原错了还能再退回来。"/>

        <Grid Grid.Row="3">
            <ListBox x:Name="HistoryList" Style="{StaticResource HistoryList}"
                     SelectionMode="Single"
                     MouseDoubleClick="HistoryList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                       FontSize="11.5" Margin="12,0,0,0"
                                       Foreground="{StaticResource Brush.TextTertiary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyHint" Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="还没有备份" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="在这里保存过一次修改之后，就会出现可还原的副本"
                               FontSize="11.5" Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Ghost}"
                    Content="打开所在目录" HorizontalAlignment="Left"
                    Click="BtnOpenFolder_Click"
                    ToolTip="备份文件与配置文件在同一目录下"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRestore" Style="{StaticResource Btn.Secondary}"
                        Content="还原此备份" MinWidth="104" Click="BtnRestore_Click"/>
                <Button x:Name="BtnClose" Style="{StaticResource Btn.Primary}"
                        Content="关闭" MinWidth="80" Margin="10,0,0,0" Click="BtnClose_Click"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
