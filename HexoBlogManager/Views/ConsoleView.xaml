<UserControl x:Class="HexoBlogManager.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 页头 ==================== -->
        <StackPanel Grid.Row="0" Margin="32,26,32,0">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="命令控制台"/>
            <TextBlock Style="{StaticResource Text.PageDesc}"
                       Text="一键执行 Hexo 命令，实时查看输出。启动预览后可以在这里直接打开浏览器。"/>
        </StackPanel>

        <!-- ==================== 命令条 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,18,32,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnClean" Style="{StaticResource Btn.Secondary}"
                            Click="BtnClean_Click" ToolTip="hexo clean — 清除缓存与已生成的 public 目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Text="&#xE74D;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="清理缓存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnGenerate" Style="{StaticResource Btn.Primary}"
                            Margin="8,0,0,0" Click="BtnGenerate_Click"
                            ToolTip="hexo generate — 生成静态站点到 public 目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Text="&#xE7C3;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="生成站点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnServer" Style="{StaticResource Btn.Primary}"
                            Margin="8,0,0,0" Click="BtnServer_Click"
                            ToolTip="hexo server — 启动本地预览服务（默认 4000 端口）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Text="&#xE768;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="启动预览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeploy" Style="{StaticResource Btn.Secondary}"
                            Margin="8,0,0,0" Click="BtnDeploy_Click"
                            ToolTip="hexo deploy — 按 _config.yml 的 deploy 配置部署">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Text="&#xE898;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="部署" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStop" Style="{StaticResource Btn.Secondary}"
                            Margin="8,0,0,0" IsEnabled="False" Click="BtnStop_Click"
                            ToolTip="强制结束当前命令（包括 hexo server 的 node 进程）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Text="&#xE71A;" Margin="0,0,7,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Danger}"/>
                            <TextBlock Text="停止" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Danger}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="空闲" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 预览地址卡 ==================== -->
        <Border x:Name="PanelUrl" Grid.Row="2" Visibility="Collapsed"
                Margin="32,14,32,0" Padding="16,13"
                Background="{StaticResource Brush.AccentSoft}"
                BorderBrush="#C7DCF2" BorderThickness="1" CornerRadius="8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="本地预览已启动" FontSize="12"
                               Foreground="{StaticResource Brush.Accent}"/>
                    <TextBlock x:Name="TxtUrl" FontSize="14" FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.Accent}"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>

                <Button x:Name="BtnOpenBrowser" Style="{StaticResource Btn.Primary}"
                        Content="打开浏览器" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnOpenBrowser_Click"/>
            </Grid>
        </Border>

        <!-- ==================== 日志区 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}"
                Margin="32,16,32,24" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 日志工具条 -->
                <Border Grid.Row="0" Padding="16,9"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="执行日志" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextPrimary}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="ChkAutoScroll" Content="自动滚动" IsChecked="True"
                                      FontSize="12" VerticalAlignment="Center"
                                      Foreground="{StaticResource Brush.TextSecondary}"/>
                            <Button x:Name="BtnCopyLog" Style="{StaticResource Btn.Ghost}"
                                    Content="复制日志" Margin="12,0,0,0"
                                    Click="BtnCopyLog_Click"/>
                            <Button x:Name="BtnClearLog" Style="{StaticResource Btn.Ghost}"
                                    Content="清空" Margin="2,0,0,0"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 深色日志面板 -->
                <!-- 底部留 8px 内边距：日志滚到底时最后一行不会贴着圆角被看掉半行 -->
                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="0,0,8,8" Padding="0,0,0,8">
                    <RichTextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10,14,10"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SelectionBrush="#264F78"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
