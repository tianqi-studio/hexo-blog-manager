<Window x:Class="HexoBlogManager.Views.PostHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史版本"
        Width="560" Height="460"
        MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 历史列表：一行一件事，右侧显示大小，整体轻量，不抢主界面的注意力 -->
        <Style x:Key="HistoryList" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Soft}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="Auto"/>   <!-- 说明 -->
            <RowDefinition Height="*"/>      <!-- 列表 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="历史版本" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock x:Name="TxtSubtitle" FontSize="11.5" Margin="0,4,0,0"
                       Foreground="{StaticResource Brush.TextTertiary}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,12,0,10" FontSize="11.5"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="每次保存前都会自动留一份原文件。选中一条记录后点「恢复」，当前内容也会被备份，恢复错了还能再退回来。"/>

        <Grid Grid.Row="2">
            <ListBox x:Name="HistoryList" Style="{StaticResource HistoryList}"
                     SelectionMode="Single"
                     MouseDoubleClick="HistoryList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                       FontSize="11.5" Margin="12,0,0,0"
                                       Foreground="{StaticResource Brush.TextTertiary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态：没有历史时盖在上面，比空列表友好 -->
            <Border x:Name="EmptyHint" Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="还没有历史版本" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="保存一次之后，这里就会出现可回退的副本"
                               FontSize="11.5" Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Ghost}"
                    Content="打开备份目录" HorizontalAlignment="Left"
                    Click="BtnOpenFolder_Click"
                    ToolTip="备份文件存放在博客根目录的 .hexo-manager/backups/posts 下"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRestore" Style="{StaticResource Btn.Secondary}"
                        Content="恢复此版本" MinWidth="96" Click="BtnRestore_Click"/>
                <Button x:Name="BtnClose" Style="{StaticResource Btn.Primary}"
                        Content="关闭" MinWidth="80" Margin="10,0,0,0" Click="BtnClose_Click"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
