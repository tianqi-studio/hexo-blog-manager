<UserControl x:Class="HexoBlogManager.Views.SiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource Brush.Window}">

        <StackPanel Margin="32,26,32,44" MaxWidth="920" HorizontalAlignment="Left">

            <!-- ==================== 页面标题 ==================== -->
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="站点与目录"/>
            <TextBlock Style="{StaticResource Text.PageDesc}"
                       Text="选择 Hexo 博客根目录后，工具会自动校验目录结构并记住位置，下次启动直接加载。"/>

            <!-- ==================== 卡片 1：博客根目录 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>

                    <!-- 标题行 + 状态徽章 -->
                    <Grid>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="博客根目录"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="PillStatus" Style="{StaticResource Pill}"
                                HorizontalAlignment="Right" Background="#EFF1F4">
                            <TextBlock x:Name="TxtPillStatus" Text="未连接" FontSize="11"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                        </Border>
                    </Grid>

                    <!-- 路径显示：只读 TextBox，方便用户 Ctrl+A / Ctrl+C 复制完整路径 -->
                    <TextBox x:Name="TxtPath"
                             Style="{StaticResource Input}"
                             IsReadOnly="True"
                             Margin="0,14,0,0"
                             Background="{StaticResource Brush.Soft}"
                             BorderBrush="{StaticResource Brush.Border}"
                             FontFamily="Consolas, Microsoft YaHei UI, Microsoft YaHei"
                             Text="尚未选择目录"/>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnSelect" Style="{StaticResource Btn.Primary}"
                                Content="选择博客文件夹" Click="BtnSelect_Click"/>
                        <Button x:Name="BtnRecheck" Style="{StaticResource Btn.Secondary}"
                                Content="重新校验" Margin="8,0,0,0" Click="BtnRecheck_Click"/>
                        <Button x:Name="BtnOpen" Style="{StaticResource Btn.Secondary}"
                                Content="在资源管理器中打开" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnOpen_Click"/>
                    </StackPanel>

                    <!-- 校验失败提示（红色块） -->
                    <Border x:Name="PanelNotice" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="{StaticResource Brush.DangerSoft}" CornerRadius="6" Padding="13,11">
                        <StackPanel>
                            <TextBlock x:Name="TxtNoticeTitle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtNoticeHint" FontSize="12" Foreground="#81281E"
                                       TextWrapping="Wrap" LineHeight="19" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ==================== 卡片 2：站点信息 ==================== -->
            <Border x:Name="CardSite" Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="站点信息"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第 1 行 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Label}"
                                   Text="站点标题" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSiteTitle"
                                   Style="{StaticResource Text.Value}" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.Label}"
                                   Text="主题" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtTheme"
                                   Style="{StaticResource Text.Value}" Margin="0,12,0,0"/>

                        <!-- 第 2 行 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Label}"
                                   Text="副标题" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSubtitle"
                                   Style="{StaticResource Text.Value}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Label}"
                                   Text="作者" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtAuthor"
                                   Style="{StaticResource Text.Value}" Margin="0,10,0,0"/>

                        <!-- 第 3 行 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Label}"
                                   Text="文章数量" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPostCount"
                                   Style="{StaticResource Text.Value}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.Label}"
                                   Text="配置更新" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtConfigTime"
                                   Style="{StaticResource Text.Value}" Margin="0,10,0,0"/>
                    </Grid>

                    <!-- 主题未安装时的提醒（正常情况隐藏） -->
                    <Border x:Name="PanelThemeWarning" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="#FFF6E5" CornerRadius="6" Padding="12,9">
                        <TextBlock x:Name="TxtThemeWarning" FontSize="12" Foreground="#7A4E00"
                                   TextWrapping="Wrap" LineHeight="19"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 卡片 3：运行环境自检 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>

                    <Grid>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="运行环境自检"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnRecheckEnv" Style="{StaticResource Btn.Ghost}"
                                Content="重新检测" HorizontalAlignment="Right"
                                Click="BtnRecheckEnv_Click"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,4,0,0"
                               Text="本工具依赖本机的 Node.js 与 hexo 命令，下面是实时检测结果。"/>

                    <!-- Node.js -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotNode" Width="8" Height="8"
                                     Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="Node.js" Width="104" Margin="10,0,0,0"
                                       Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="TxtNode" Style="{StaticResource Text.Value}"
                                       Text="等待检测…"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtNodeHint" Visibility="Collapsed" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                                   LineHeight="18" Margin="18,4,0,0"/>
                    </StackPanel>

                    <!-- hexo-cli -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotHexo" Width="8" Height="8"
                                     Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="hexo-cli" Width="104" Margin="10,0,0,0"
                                       Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="TxtHexo" Style="{StaticResource Text.Value}"
                                       Text="等待检测…"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtHexoHint" Visibility="Collapsed" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                                   LineHeight="18" Margin="18,4,0,0"/>
                    </StackPanel>

                    <!-- 当前博客目录下的命令执行 -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotBlogCmd" Width="8" Height="8"
                                     Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="博客命令" Width="104" Margin="10,0,0,0"
                                       Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="TxtBlogCmd" Style="{StaticResource Text.Value}"
                                       Text="选择目录后检测"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBlogCmdHint" Visibility="Collapsed" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                                   LineHeight="18" Margin="18,4,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ==================== 底部说明 ==================== -->
            <TextBlock x:Name="TxtSettingsPath" FontSize="11"
                       Foreground="{StaticResource Brush.TextTertiary}"
                       TextWrapping="Wrap" Margin="2,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
